# Reconcile the full display state when the physical keyboard docks or detaches.
# The service rechecks USB state after settling, so virtual devices are ignored.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0b05", ATTR{idProduct}=="1cd7", TAG+="systemd", ENV{SYSTEMD_WANTS}+="zenbook-duo-display-control@sync.service"
ACTION=="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="b05/1cd7/*", RUN+="/usr/bin/systemctl --no-block start zenbook-duo-display-control@sync.service"

# The upper panel is mounted 180 degrees from its touch digitizer. Correct only
# finger-touch events; the lower touchscreen and both stylus interfaces remain unchanged.
ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event[0-9]*", ENV{ID_INPUT_TOUCHSCREEN}=="1", ATTRS{id/vendor}=="2386", ATTRS{id/product}=="8c05", ENV{LIBINPUT_CALIBRATION_MATRIX}="-1 0 1 0 -1 1"
