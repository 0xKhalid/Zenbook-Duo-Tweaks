#!/usr/bin/env python3
"""Event-driven activity watcher for the UX8407AA detachable keyboard."""

import errno
import hashlib
import math
import os
import pathlib
import re
import selectors
import signal
import socket
import stat
import struct
import subprocess
import sys
import time
from collections import deque
from statistics import median

USB_ID = "0003:00000B05:00001CD7"
BLUETOOTH_ID = "0005:00000B05:00001CD8"
EVENT = struct.Struct("@llHHI")
EV_KEY = 0x01
EV_ABS = 0x03
AMBIENT_POLL_SECONDS = 2.0
AMBIENT_FAILURE_LIMIT = 3
AMBIENT_SAMPLE_COUNT = 3
AMBIENT_HYSTERESIS = 0.20
AMBIENT_BANDS = (
    ("dark", 3),
    ("dim", 2),
    ("normal", 1),
    ("bright", 0),
)
FORWARDED_IDENTITIES = {
    USB_ID: {
        "bus": "0003",
        "vendor": "0b05",
        "product": "1cd7",
        "keyboard": "Primax Electronics Ltd. ASUS Zenbook Duo Keyboard",
        "touchpad": "Primax Electronics Ltd. ASUS Zenbook Duo Keyboard Touchpad",
    },
    BLUETOOTH_ID: {
        "bus": "0005",
        "vendor": "0b05",
        "product": "1cd8",
        "keyboard": "ASUS Zenbook Duo Keyboard",
        "touchpad": "ASUS Zenbook Duo Keyboard Touchpad",
    },
}


def fail(message):
    print(f"kbd-backlight activity: {message}", file=sys.stderr)
    raise SystemExit(1)


def journal(message):
    """Write only fixed, privacy-safe state transitions to the user journal."""
    print(f"kbd-backlight activity: {message}", file=sys.stderr, flush=True)


def read_properties(path):
    result = subprocess.run(
        ["udevadm", "info", "--query=property", f"--path={path}"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode:
        return {}
    properties = {}
    for line in result.stdout.splitlines():
        key, separator, value = line.partition("=")
        if separator:
            properties[key] = value
    return properties


def uevent_value(path, key):
    try:
        for line in (path / "uevent").read_text().splitlines():
            if line.startswith(key + "="):
                return line.split("=", 1)[1]
    except OSError:
        pass
    return ""


def driver_name(path):
    try:
        return pathlib.Path(os.path.realpath(path / "driver")).name
    except OSError:
        return ""


def hid_parent(path):
    current = path.resolve()
    for parent in (current, *current.parents):
        identity = uevent_value(parent, "HID_ID")
        if identity in {USB_ID, BLUETOOTH_ID}:
            return parent, identity
    return None, ""


def usb_interface_number(path):
    for parent in (path.resolve(), *path.resolve().parents):
        try:
            return (parent / "bInterfaceNumber").read_text().strip().lower()
        except OSError:
            continue
    return ""


def descriptor_valid(path):
    try:
        data = (path / "report_descriptor").read_bytes()
    except OSError:
        return False
    for offset in range(max(0, len(data) - 1)):
        if data[offset : offset + 2] != b"\x85\x5a":
            continue
        window = data[offset : offset + 64]
        if b"\x95\x0f" in window and b"\xb1" in window:
            return True
    return False


def input_kind(properties):
    kinds = []
    if properties.get("ID_INPUT_KEYBOARD") == "1":
        kinds.append("keyboard")
    if properties.get("ID_INPUT_TOUCHPAD") == "1":
        kinds.append("touchpad")
    return kinds[0] if len(kinds) == 1 else ""


def read_attribute(path, name):
    try:
        return (path / name).read_text().strip()
    except OSError:
        return ""


def discover_ambient_sensor(sysfs_root):
    root = pathlib.Path(sysfs_root)
    devices_root = root / "devices"
    candidates = []
    for entry in sorted((root / "bus/iio/devices").glob("iio:device*")):
        try:
            device = entry.resolve(strict=True)
            device.relative_to(devices_root.resolve(strict=True))
        except (OSError, ValueError):
            continue
        if read_attribute(device, "name") != "als":
            continue
        candidate = (entry, device)
        if read_ambient_lux(candidate) is not None:
            candidates.append(candidate)
    return candidates[0] if len(candidates) == 1 else None


def read_ambient_lux(sensor):
    if sensor is None:
        return None
    entry, expected_device = sensor
    try:
        if entry.resolve(strict=True) != expected_device or read_attribute(expected_device, "name") != "als":
            return None
        raw_path = expected_device / "in_illuminance_raw"
        scale_path = expected_device / "in_illuminance_scale"
        offset_path = expected_device / "in_illuminance_offset"
        if raw_path.is_symlink() or scale_path.is_symlink() or offset_path.is_symlink():
            return None
        if not os.access(raw_path, os.R_OK) or not os.access(scale_path, os.R_OK):
            return None
        raw = float(raw_path.read_text().strip())
        scale = float(scale_path.read_text().strip())
        offset = float(offset_path.read_text().strip()) if offset_path.exists() else 0.0
        lux = (raw + offset) * scale
    except (OSError, ValueError, OverflowError):
        return None
    if not all(math.isfinite(value) for value in (raw, scale, offset, lux)):
        return None
    if scale <= 0 or lux < 0 or lux > 1_000_000:
        return None
    try:
        if entry.resolve(strict=True) != expected_device:
            return None
    except OSError:
        return None
    return lux


def base_ambient_band(lux, thresholds):
    dark, dim, bright = thresholds
    if lux < dark:
        return 0
    if lux < dim:
        return 1
    if lux < bright:
        return 2
    return 3


def ambient_band(lux, thresholds, current=None):
    candidate = base_ambient_band(lux, thresholds)
    if current is None or candidate == current:
        return candidate
    if candidate > current:
        boundary = thresholds[current]
        if lux < boundary * (1.0 + AMBIENT_HYSTERESIS):
            return current
    else:
        boundary = thresholds[current - 1]
        if lux >= boundary * (1.0 - AMBIENT_HYSTERESIS):
            return current
    return candidate


def sensor_status(sysfs_root):
    lux = read_ambient_lux(discover_ambient_sensor(sysfs_root))
    if lux is None:
        print("status=unavailable")
        return 1
    print(f"status=available lux={lux:.1f}")
    return 0


def forwarded_activity_matches(root, device, identity, kind):
    expected = FORWARDED_IDENTITIES.get(identity)
    if expected is None:
        return False
    try:
        virtual_root = (root / "devices/virtual/input").resolve(strict=True)
    except OSError:
        return False
    if device.parent != virtual_root or not device.name.startswith("input"):
        return False
    return (
        read_attribute(device, "phys").startswith("input-remapper/")
        and read_attribute(device, "id/bustype").lower() == expected["bus"]
        and read_attribute(device, "id/vendor").lower() == expected["vendor"]
        and read_attribute(device, "id/product").lower() == expected["product"]
        and read_attribute(device, "name") == expected[kind]
    )


def selected_backlight(sysfs_root):
    root = pathlib.Path(sysfs_root)
    matches = []
    for transport, pattern, identity in (
        ("usb", "0003:0B05:1CD7.*", USB_ID),
        ("bluetooth", "0005:0B05:1CD8.*", BLUETOOTH_ID),
    ):
        candidates = []
        for link in (root / "bus/hid/devices").glob(pattern):
            try:
                device = link.resolve(strict=True)
            except OSError:
                continue
            if uevent_value(device, "HID_ID") != identity:
                continue
            if driver_name(device) != "hid-generic" or not descriptor_valid(device):
                continue
            if transport == "usb":
                if not uevent_value(device, "HID_PHYS").endswith("/input4"):
                    continue
                if usb_interface_number(device) != "04":
                    continue
            candidates.append(device)
        if len(candidates) > 1:
            return None
        if len(candidates) == 1:
            token = hashlib.sha256(str(candidates[0]).encode()).hexdigest()
            matches.append((transport, identity, token))
            break
    return matches[0] if matches else None


def activity_candidates(sysfs_root, identity):
    root = pathlib.Path(sysfs_root)
    physical = {"keyboard": [], "touchpad": []}
    forwarded = {"keyboard": [], "touchpad": []}
    for entry in sorted((root / "class/input").glob("event*")):
        try:
            device = (entry / "device").resolve(strict=True)
        except OSError:
            continue
        properties = read_properties(entry)
        kind = input_kind(properties)
        if not kind:
            continue
        parent, found_identity = hid_parent(device)
        if parent is not None and found_identity == identity:
            physical[kind].append((entry, device))
        elif forwarded_activity_matches(root, device, identity, kind):
            forwarded[kind].append((entry, device))
    return physical, forwarded


def open_activity_node(dev_root, candidate, kind, source):
    entry, expected_device = candidate
    node = pathlib.Path(dev_root) / "input" / entry.name
    try:
        before = node.stat()
    except OSError:
        return None
    if not stat.S_ISCHR(before.st_mode) or not os.access(node, os.R_OK):
        return None
    try:
        descriptor = os.open(node, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        opened = os.fstat(descriptor)
        current_device = (entry / "device").resolve(strict=True)
        if (
            not stat.S_ISCHR(opened.st_mode)
            or (opened.st_dev, opened.st_ino, opened.st_rdev)
            != (before.st_dev, before.st_ino, before.st_rdev)
            or current_device != expected_device
        ):
            raise OSError(errno.ENODEV, "input identity changed during open")
    except OSError:
        os.close(descriptor)
        return None
    return descriptor, kind, node.name, source


def activity_nodes(sysfs_root, dev_root, identity):
    physical, forwarded = activity_candidates(sysfs_root, identity)
    selected = []
    for kind in ("keyboard", "touchpad"):
        if len(forwarded[kind]) > 1:
            return []
        if len(forwarded[kind]) == 1:
            selected.append((forwarded[kind][0], kind, "forwarded"))
        else:
            selected.extend((candidate, kind, "physical") for candidate in physical[kind])
    if not {kind for _, kind, _ in selected}.issuperset({"keyboard", "touchpad"}):
        return []

    nodes = []
    for candidate, kind, source in selected:
        opened = open_activity_node(dev_root, candidate, kind, source)
        if opened is None:
            for descriptor, _, _, _ in nodes:
                os.close(descriptor)
            return []
        nodes.append(opened)
    return nodes


def session_token():
    override = os.environ.get("KBD_BACKLIGHT_SESSION_TOKEN", "")
    if re.fullmatch(r"[0-9a-f]{64}", override):
        return override
    uid = str(os.getuid())
    try:
        sessions = subprocess.run(
            ["loginctl", "list-sessions", "--no-legend"],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        ).stdout.splitlines()
    except (OSError, subprocess.CalledProcessError):
        fail("active local session is unavailable")
    for row in sessions:
        fields = row.split()
        if len(fields) < 2 or fields[1] != uid:
            continue
        sid = fields[0]
        values = {}
        for key in ("Active", "Remote", "Class", "Type", "TimestampMonotonic"):
            result = subprocess.run(
                ["loginctl", "show-session", sid, "-p", key, "--value"],
                check=False,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
            )
            values[key] = result.stdout.strip()
        if (
            values.get("Active") != "yes"
            or values.get("Remote") != "no"
            or values.get("Class") != "user"
        ):
            continue
        if values.get("Type") not in {"wayland", "x11"}:
            continue
        material = f"{sid}:{values.get('TimestampMonotonic', '')}"
        return hashlib.sha256(material.encode()).hexdigest()
    fail("active local graphical session is unavailable")


def controller_call(controller, *arguments):
    result = subprocess.run(
        [controller, *arguments],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env={**os.environ, "KBD_BACKLIGHT_DISABLE_OSD": "1"},
    )
    if result.returncode:
        return None
    outcome = result.stdout.strip()
    return outcome if re.fullmatch(r"result=[a-z-]+", outcome) else "result=ok"


class Watcher:
    def __init__(
        self,
        controller,
        timeout,
        ambient_enabled,
        ambient_dark,
        ambient_dim,
        ambient_bright,
        sysfs_root,
        dev_root,
    ):
        self.controller = controller
        self.timeout = timeout
        self.sysfs_root = sysfs_root
        self.dev_root = dev_root
        self.session = session_token()
        self.selector = selectors.DefaultSelector()
        self.input_descriptors = {}
        self.input_buffers = {}
        self.input_names = {}
        self.input_sources = {}
        self.connection_token = None
        self.deadline = None
        self.idled = False
        self.rescan_due = 0.0
        self.reported_topology = None
        self.ambient_enabled = ambient_enabled
        self.ambient_thresholds = (ambient_dark, ambient_dim, ambient_bright)
        self.ambient_sensor = None
        self.ambient_samples = deque(maxlen=AMBIENT_SAMPLE_COUNT)
        self.ambient_invalid = 0
        self.ambient_status = "warming" if ambient_enabled else "disabled"
        self.ambient_lux = None
        self.ambient_band = None
        self.ambient_target = None
        self.ambient_fallback_applied = False
        self.sensor_due = time.monotonic() if ambient_enabled else 0.0
        self.health_topology = None
        self.last_health_content = None
        runtime = pathlib.Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
        self.health_file = runtime / "zenbook-tweaks" / "kbd-backlight-watcher"

    def schedule_rescan(self, delay):
        due = time.monotonic() + delay
        if not self.rescan_due or due < self.rescan_due:
            self.rescan_due = due

    def write_health(
        self, transport, keyboard, keyboard_source, touchpad, touchpad_source
    ):
        self.health_topology = (
            transport,
            keyboard,
            keyboard_source,
            touchpad,
            touchpad_source,
        )
        self.flush_health()

    def flush_health(self):
        if self.health_topology is None:
            return
        transport, keyboard, keyboard_source, touchpad, touchpad_source = (
            self.health_topology
        )
        ambient_lux = (
            str(round(self.ambient_lux)) if self.ambient_lux is not None else "none"
        )
        ambient_band_name = (
            AMBIENT_BANDS[self.ambient_band][0]
            if self.ambient_band is not None
            else "none"
        )
        ambient_target = (
            str(self.ambient_target) if self.ambient_target is not None else "none"
        )
        content = (
            f"version=3\ntransport={transport}\n"
            f"keyboard={keyboard}\nkeyboard_source={keyboard_source}\n"
            f"touchpad={touchpad}\ntouchpad_source={touchpad_source}\n"
            f"ambient_status={self.ambient_status}\nambient_lux={ambient_lux}\n"
            f"ambient_band={ambient_band_name}\nambient_target={ambient_target}\n"
        ).encode()
        if content == self.last_health_content:
            return
        directory = self.health_file.parent
        try:
            if directory.is_symlink():
                return
            directory.mkdir(mode=0o700, parents=True, exist_ok=True)
            if directory.stat().st_uid != os.getuid():
                return
            directory.chmod(0o700)
            temporary = directory / f".kbd-backlight-watcher.{os.getpid()}"
            descriptor = os.open(
                temporary,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC,
                0o600,
            )
            try:
                os.write(descriptor, content)
            finally:
                os.close(descriptor)
            os.replace(temporary, self.health_file)
            self.last_health_content = content
        except OSError:
            try:
                temporary.unlink()
            except (OSError, UnboundLocalError):
                pass

    def remove_health(self):
        try:
            if not self.health_file.is_symlink():
                self.health_file.unlink(missing_ok=True)
        except OSError:
            pass

    def drop_input(self, descriptor):
        try:
            self.selector.unregister(descriptor)
        except Exception:
            pass
        self.input_descriptors.pop(descriptor, None)
        self.input_buffers.pop(descriptor, None)
        self.input_names.pop(descriptor, None)
        self.input_sources.pop(descriptor, None)
        try:
            os.close(descriptor)
        except OSError:
            pass

    def close_inputs(self):
        for descriptor in list(self.input_descriptors):
            self.drop_input(descriptor)

    def report_topology(self, topology, message):
        if topology != self.reported_topology:
            journal(message)
            self.reported_topology = topology

    def reset_ambient(self, waiting=False):
        if not self.ambient_enabled:
            return
        self.ambient_sensor = None
        self.ambient_samples.clear()
        self.ambient_invalid = 0
        self.ambient_status = "waiting" if waiting else "warming"
        self.ambient_lux = None
        self.ambient_band = None
        self.ambient_target = None
        self.ambient_fallback_applied = False
        self.sensor_due = time.monotonic()

    def poll_ambient(self):
        if not self.ambient_enabled:
            return
        self.sensor_due = time.monotonic() + AMBIENT_POLL_SECONDS
        if self.connection_token is None:
            self.ambient_status = "waiting"
            self.flush_health()
            return
        if self.ambient_sensor is None:
            self.ambient_sensor = discover_ambient_sensor(self.sysfs_root)
        lux = read_ambient_lux(self.ambient_sensor)
        if lux is None:
            self.ambient_sensor = None
            self.ambient_samples.clear()
            self.ambient_lux = None
            self.ambient_invalid += 1
            if self.ambient_invalid < AMBIENT_FAILURE_LIMIT:
                self.ambient_status = "warming"
                self.flush_health()
                return
            self.ambient_status = "unavailable"
            self.ambient_band = None
            if not self.ambient_fallback_applied:
                outcome = controller_call(self.controller, "_auto-target", "1", "fallback")
                if outcome is not None:
                    self.ambient_target = 1
                    self.ambient_fallback_applied = True
                    journal(
                        f"ambient sensor=unavailable target=low result={outcome.removeprefix('result=')}"
                    )
            self.flush_health()
            return

        self.ambient_invalid = 0
        self.ambient_lux = lux
        self.ambient_samples.append(lux)
        if len(self.ambient_samples) < AMBIENT_SAMPLE_COUNT:
            self.ambient_status = "warming"
            self.flush_health()
            return

        smoothed = median(self.ambient_samples)
        self.ambient_fallback_applied = False
        candidate = ambient_band(
            smoothed, self.ambient_thresholds, self.ambient_band
        )
        target = AMBIENT_BANDS[candidate][1]
        self.ambient_status = "available"
        if candidate != self.ambient_band or target != self.ambient_target:
            outcome = controller_call(
                self.controller, "_auto-target", str(target), "ambient"
            )
            if outcome is None:
                journal("controller action=ambient result=failed")
                self.flush_health()
                return
            self.ambient_band = candidate
            self.ambient_target = target
            journal(
                f"ambient band={AMBIENT_BANDS[candidate][0]} "
                f"target={('off', 'low', 'medium', 'high')[target]} "
                f"result={outcome.removeprefix('result=')}"
            )
        self.flush_health()

    def rescan(self):
        self.close_inputs()
        selected = selected_backlight(self.sysfs_root)
        if selected is None:
            self.connection_token = None
            self.deadline = None
            self.idled = False
            self.reset_ambient(waiting=True)
            self.write_health("disconnected", "none", "none", "none", "none")
            self.report_topology(
                ("disconnected",), "connection transport=disconnected"
            )
            return
        transport, identity, token = selected
        nodes = activity_nodes(self.sysfs_root, self.dev_root, identity)
        if not nodes:
            self.deadline = None
            self.write_health(
                transport,
                "unavailable",
                "unavailable",
                "unavailable",
                "unavailable",
            )
            self.report_topology(
                ("unavailable", transport),
                f"activity-sources transport={transport} keyboard=unavailable touchpad=unavailable",
            )
            self.schedule_rescan(1.0)
            return
        names = {"keyboard": [], "touchpad": []}
        sources = {"keyboard": set(), "touchpad": set()}
        for descriptor, kind, name, source in nodes:
            self.input_descriptors[descriptor] = kind
            self.input_buffers[descriptor] = b""
            self.input_names[descriptor] = name
            self.input_sources[descriptor] = source
            names[kind].append(name)
            sources[kind].add(source)
            self.selector.register(descriptor, selectors.EVENT_READ, "input")
        if token != self.connection_token:
            outcome = controller_call(
                self.controller, "_auto-connect", self.session, token
            )
            if outcome is None:
                self.deadline = None
                journal(f"controller action=connect transport={transport} result=failed")
                self.schedule_rescan(1.0)
                return
            self.connection_token = token
            self.idled = False
            self.reset_ambient()
            initialization = outcome.removeprefix("result=")
            journal(
                f"connection transport={transport} initialization={initialization}"
            )
        if self.deadline is None:
            self.deadline = time.monotonic() + self.timeout
        self.rescan_due = 0.0
        keyboard_source = next(iter(sources["keyboard"]))
        touchpad_source = next(iter(sources["touchpad"]))
        self.write_health(
            transport,
            ",".join(sorted(names["keyboard"])),
            keyboard_source,
            ",".join(sorted(names["touchpad"])),
            touchpad_source,
        )
        self.report_topology(
            ("ready", transport, keyboard_source, touchpad_source),
            f"activity-sources transport={transport} keyboard={keyboard_source} touchpad={touchpad_source}",
        )

    def activity(self, kind, source):
        self.deadline = time.monotonic() + self.timeout
        if self.idled:
            outcome = controller_call(self.controller, "_auto-resume")
            if outcome is None:
                journal(
                    f"controller action=resume source={kind}-{source} result=failed"
                )
                return
            if outcome == "result=resumed":
                journal(f"activity-restored source={kind}-{source}")
            self.idled = False

    def idle_if_due(self):
        outcome = controller_call(self.controller, "_auto-idle")
        if outcome is None:
            journal("controller action=idle result=failed")
            self.deadline = time.monotonic() + min(5, self.timeout)
            return
        self.idled = True
        if outcome == "result=idled":
            journal(f"idle-off timeout={self.timeout}")

    def input_ready(self, descriptor):
        try:
            chunk = os.read(descriptor, EVENT.size * 64)
        except OSError as error:
            if error.errno not in {errno.EAGAIN, errno.EWOULDBLOCK}:
                self.drop_input(descriptor)
                self.schedule_rescan(0.05)
            return
        if not chunk:
            self.drop_input(descriptor)
            self.schedule_rescan(0.05)
            return
        buffer = self.input_buffers.get(descriptor, b"") + chunk
        kind = self.input_descriptors[descriptor]
        active = False
        while len(buffer) >= EVENT.size:
            _, _, event_type, _, value = EVENT.unpack_from(buffer)
            buffer = buffer[EVENT.size :]
            if kind == "keyboard" and event_type == EV_KEY and value in {1, 2}:
                active = True
            elif kind == "touchpad" and event_type in {EV_KEY, EV_ABS}:
                active = True
        self.input_buffers[descriptor] = buffer
        if active:
            self.activity(kind, self.input_sources[descriptor])

    def run_production(self):
        monitor = socket.socket(socket.AF_NETLINK, socket.SOCK_DGRAM, 15)
        monitor.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 1024 * 1024)
        monitor.bind((os.getpid(), 1))
        monitor.setblocking(False)
        self.selector.register(monitor, selectors.EVENT_READ, "udev")
        self.rescan()
        while True:
            now = time.monotonic()
            waits = []
            if self.deadline is not None and not self.idled:
                waits.append(max(0.0, self.deadline - now))
            if self.rescan_due:
                waits.append(max(0.0, self.rescan_due - now))
            if self.ambient_enabled and self.connection_token is not None:
                waits.append(max(0.0, self.sensor_due - now))
            timeout = min(waits) if waits else None
            for key, _ in self.selector.select(timeout):
                if key.data == "udev":
                    try:
                        message = monitor.recv(65536)
                    except BlockingIOError:
                        continue
                    fields = message.split(b"\0")
                    if any(field in {b"SUBSYSTEM=input", b"SUBSYSTEM=hidraw", b"SUBSYSTEM=hid"} for field in fields):
                        self.schedule_rescan(0.25)
                else:
                    self.input_ready(key.fd)
            now = time.monotonic()
            if self.rescan_due and now >= self.rescan_due:
                self.rescan()
            if (
                self.ambient_enabled
                and self.connection_token is not None
                and now >= self.sensor_due
            ):
                self.poll_ambient()
            if self.deadline is not None and not self.idled and now >= self.deadline:
                self.idle_if_due()

    def run_test_source(self, helper):
        process = subprocess.Popen(
            [helper], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
        )
        self.selector.register(process.stdout, selectors.EVENT_READ, "source")
        while True:
            wait = None
            if self.deadline is not None and not self.idled:
                wait = max(0.0, self.deadline - time.monotonic())
            events = self.selector.select(wait)
            if not events:
                self.idle_if_due()
                continue
            line = process.stdout.readline()
            if not line:
                return process.wait()
            fields = line.strip().split()
            if len(fields) == 2 and fields[0] == "connect" and re.fullmatch(r"[0-9a-f]{64}", fields[1]):
                outcome = controller_call(
                    self.controller, "_auto-connect", self.session, fields[1]
                )
                if outcome is None:
                    continue
                self.connection_token = fields[1]
                self.deadline = time.monotonic() + self.timeout
                self.idled = False
            elif fields == ["disconnect"]:
                self.connection_token = None
                self.deadline = None
                self.idled = False
            elif fields and fields[0] in {"keyboard", "touchpad"}:
                self.activity(fields[0], "test")


def main():
    if sys.argv[1:] == ["--sensor-status"]:
        return sensor_status(os.environ.get("KBD_BACKLIGHT_SYSFS_ROOT", "/sys"))
    if len(sys.argv) != 7 or not all(value.isdigit() for value in sys.argv[2:]):
        fail(
            "usage: kbd-backlight-activity CONTROLLER TIMEOUT_SECONDS "
            "AMBIENT_ENABLED DARK_LUX DIM_LUX BRIGHT_LUX"
        )
    timeout = int(sys.argv[2])
    if timeout < 1 or timeout > 7200:
        fail("invalid timeout")
    ambient_enabled = int(sys.argv[3])
    thresholds = tuple(int(value) for value in sys.argv[4:7])
    if (
        ambient_enabled not in {0, 1}
        or not 1 <= thresholds[0] < thresholds[1] < thresholds[2] <= 100_000
    ):
        fail("invalid ambient configuration")
    watcher = Watcher(
        sys.argv[1],
        timeout,
        bool(ambient_enabled),
        *thresholds,
        os.environ.get("KBD_BACKLIGHT_SYSFS_ROOT", "/sys"),
        os.environ.get("KBD_BACKLIGHT_DEV_ROOT", "/dev"),
    )
    helper = os.environ.get("KBD_BACKLIGHT_ACTIVITY_SOURCE", "")
    def terminate(_signum, _frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, terminate)
    signal.signal(signal.SIGINT, terminate)
    try:
        if helper:
            return watcher.run_test_source(helper)
        return watcher.run_production()
    finally:
        watcher.close_inputs()
        watcher.remove_health()


if __name__ == "__main__":
    raise SystemExit(main())
